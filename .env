# Variables públicas de Vite. Copiar a .env.local y reiniciar/recompilar.
# PENDIENTE: correo corporativo verificado de MUHU (sin placeholder público ficticio).
VITE_MUHU_CONTACT_EMAIL=
# PENDIENTE: ruta de un backend propio, por ejemplo /api/contact.
# Dejar vacío mantiene el envío deshabilitado y muestra un aviso honesto.
VITE_MUHU_FORM_ENDPOINT=
# Opcional; completar únicamente con el RUC verificado.
VITE_MUHU_RUC=
